---
const fmt = (v: number, d = 0) =>
  v.toLocaleString("en-IN", { minimumFractionDigits: d, maximumFractionDigits: d });

const stats = [
  { value: 47892, label: "Entries Posted", note: "not one left behind" },
  { value: 99.997, decimals: 3, suffix: "%", label: "Ledger Accuracy", note: "auditors checked. twice." },
  { value: 0, label: "Unbalanced Closures", note: "a flawless record — and counting" },
  { value: 14203, label: "Variances Hunted", note: "they cannot hide" },
];
---

<section class="stats" id="stats">
  <div class="wrap">
    <div class="grid">
      {
        stats.map((s) => (
          <div class="stat reveal">
            <div class="value mono">
              <span data-target={s.value} data-decimals={s.decimals ?? 0} data-suffix={s.suffix ?? ""}>
                {fmt(s.value, s.decimals ?? 0) + (s.suffix ?? "")}
              </span>
            </div>
            <div class="label">{s.label}</div>
            <div class="note mono">{s.note}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    padding: 88px 0 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .stat {
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--panel-strong), var(--panel));
    border-radius: var(--radius);
    padding: 28px;
  }
  .value {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 700;
    color: var(--gold-soft);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .label {
    font-weight: 600;
    margin-top: 8px;
  }
  .note {
    color: var(--dim);
    font-size: 12px;
    margin-top: 8px;
    letter-spacing: 0.04em;
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
