---
const skills = [
  { name: "Excel Sorcery", pct: 98 },
  { name: "Reconciliation Speedruns", pct: 97 },
  { name: "Ledger Forensics", pct: 95 },
  { name: "Tally & ERP Whispering", pct: 93 },
  { name: "Depreciation Philosophy", pct: 89 },
  { name: "Caffeine → Journal Entries", pct: 100 },
];

const achievements = [
  "🏅 Zero-Variance Quarter",
  "🧮 Mental Math: Brutal",
  "📊 Pivot Table Prodigy",
  "☕ Caffeine Immunity: Mythic",
  "🔥 12-Entity GST Streak",
  "🌙 Quarter-End Survivor ×8",
  "🕵️ Suspense Account Exterminator",
  "📜 Audit Trail Artisan",
];
---

<section class="section" id="skills">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">✦ Character Sheet ✦</p>
      <h2>Skills so sharp, they round themselves up.</h2>
      <p class="blurb">
        Independently peer-reviewed by everyone who has ever shared a drive folder with him.
      </p>
    </div>

    <div class="grid">
      <div class="bars">
        {
          skills.map((s) => (
            <div class="skill reveal">
              <div class="row">
                <span>{s.name}</span>
                <span class="mono gold">{s.pct}%</span>
              </div>
              <div class="fill-bar">
                <i data-pct={`${s.pct}%`} />
              </div>
            </div>
          ))
        }
      </div>
      <div class="side">
        <p class="side-title mono reveal">UNLOCKED ACHIEVEMENTS</p>
        <div class="chips">
          {achievements.map((a) => <span class="chip reveal">{a}</span>)}
        </div>
      </div>
    </div>

    <div class="quotes">
      <figure class="quote reveal">
        <blockquote>“He once found an error I'd hidden. In my defence, I had hidden it from myself as well.”</blockquote>
        <figcaption class="mono">— FORMER SENIOR, NAME REDACTED</figcaption>
      </figure>
      <figure class="quote reveal">
        <blockquote>“The books don't lie to him. Trust me — they've tried.”</blockquote>
        <figcaption class="mono">— THE GENERAL LEDGER</figcaption>
      </figure>
      <figure class="quote reveal">
        <blockquote>“10/10, would reconcile again.”</blockquote>
        <figcaption class="mono">— THE TRIAL BALANCE</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: start;
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .skill .row {
    display: flex;
    justify-content: space-between;
    font-weight: 500;
    font-size: 0.95rem;
    margin-bottom: 9px;
  }
  .side-title {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 0.85rem;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .chip:hover {
    border-color: rgba(242, 182, 61, 0.5);
    transform: translateY(-2px);
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 72px;
  }
  .quote {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  blockquote {
    margin: 0;
    flex: 1;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  figcaption {
    color: var(--dim);
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
