{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gokul-lol-website",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "routes": [{ "pattern": "gokul.lol", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
